# ==============================================================================
# STUDENT ATTENDANCE MANAGER - ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to '.env' (or '.env.local') for local testing,
# or set these in your Cloudflare Pages dashboard -> Settings -> Environment Variables.

# 1. Supabase Project URL (Found in Supabase: Project Settings -> API -> Project URL)
# Example: https://xyzcompanyproject.supabase.co
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# 2. Supabase Anon Key (Found in Supabase: Project Settings -> API -> Project API Keys -> anon / public)
# NEVER put your service_role secret key here! Only the public anon key is safe for client code.
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
